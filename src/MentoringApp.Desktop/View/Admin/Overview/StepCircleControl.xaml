<UserControl
    x:Class="MentoringApp.View.Admin.Overview.StepCircleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="control">

    <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#F3F4F6"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive, ElementName=control}" Value="True">
                        <Setter Property="Background" Value="#A855F7"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsComplete, ElementName=control}" Value="True">
                        <Setter Property="Background" Value="#A855F7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock Text="✓" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"
                   Visibility="{Binding IsComplete, ElementName=control, Converter={StaticResource BoolToVis}}"/>
    </Border>
</UserControl>
