<UserControl
    x:Class="MentoringApp.View.Admin.Overview.PhaseStepperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:MentoringApp.ViewModel.Localization;assembly=MentoringApp.ViewModel"
    xmlns:overview="clr-namespace:MentoringApp.View.Admin.Overview"
    FlowDirection="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=FlowDirection}">

    <UserControl.Resources>
        <!-- Shared style for the phase-info "?" buttons -->
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="?"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Command" Value="{Binding DataContext.ShowPhaseInfoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Margin="0,0,0,24">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Progress.IsProcessComplete}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>

            <!-- Circles + connecting lines -->
            <Grid Margin="12,0">
                <!--
                    Lines grid: 7 columns (* 2* 2* 2* 2* 2* *).
                    Total = 12 units. Each line column (2*) runs from the centre of
                    one circle to the centre of the next, so the lines always reach
                    exactly into the circles regardless of window width.
                -->
                <Grid IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Background (gray) segments -->
                    <Rectangle Grid.Column="1" Height="3" Fill="#F3F4F6"/>
                    <Rectangle Grid.Column="2" Height="3" Fill="#F3F4F6"/>
                    <Rectangle Grid.Column="3" Height="3" Fill="#F3F4F6"/>
                    <Rectangle Grid.Column="4" Height="3" Fill="#F3F4F6"/>
                    <Rectangle Grid.Column="5" Height="3" Fill="#F3F4F6"/>

                    <!-- Filled (purple) segments when step is complete -->
                    <Rectangle Grid.Column="1" Height="3" Fill="#A855F7" Visibility="{Binding Progress.IsSchoolConfigured,    Converter={StaticResource BoolToVis}}"/>
                    <Rectangle Grid.Column="2" Height="3" Fill="#A855F7" Visibility="{Binding Progress.IsUsersImported,        Converter={StaticResource BoolToVis}}"/>
                    <Rectangle Grid.Column="3" Height="3" Fill="#A855F7" Visibility="{Binding Progress.IsSupervisorsAssigned,  Converter={StaticResource BoolToVis}}"/>
                    <Rectangle Grid.Column="4" Height="3" Fill="#A855F7" Visibility="{Binding Progress.IsSelectionPhaseActive, Converter={StaticResource BoolToVis}}"/>
                    <Rectangle Grid.Column="5" Height="3" Fill="#A855F7" Visibility="{Binding Progress.IsProcessComplete,      Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Circle nodes rendered on top of the lines -->
                <UniformGrid Rows="1" Columns="6">
                    <overview:StepCircleControl IsActive="True"
                                               IsComplete="{Binding Progress.IsSchoolConfigured}"/>
                    <overview:StepCircleControl IsActive="{Binding Progress.IsImportStepActive}"
                                               IsComplete="{Binding Progress.IsUsersImported}"/>
                    <overview:StepCircleControl IsActive="{Binding Progress.IsSupervisorAssignmentStepActive}"
                                               IsComplete="{Binding Progress.IsSupervisorsAssigned}"/>
                    <overview:StepCircleControl IsActive="{Binding Progress.IsRegistrationStepActive}"
                                               IsComplete="{Binding Progress.IsSelectionPhaseActive}"/>
                    <overview:StepCircleControl IsActive="{Binding Progress.IsMentorSelectionStepActive}"
                                               IsComplete="{Binding Progress.IsProcessComplete}"/>
                    <overview:StepCircleControl IsComplete="{Binding Progress.IsProcessComplete}"/>
                </UniformGrid>
            </Grid>

            <!-- Step labels — UniformGrid gives each label the full 1/6 width so text wraps properly -->
            <UniformGrid Rows="1" Columns="6" Margin="12,12,12,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [Admin_Step_SchoolConfig], Source={x:Static loc:TranslationSource.Instance}}"
                               FontSize="11" TextWrapping="Wrap" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource InfoButtonStyle}" CommandParameter="SchoolConfig"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [Admin_Step_ImportUsers], Source={x:Static loc:TranslationSource.Instance}}"
                               FontSize="11" TextWrapping="Wrap" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource InfoButtonStyle}" CommandParameter="Import"
                            ToolTip="{Binding [Admin_ImportUsersInfo_Tooltip], Source={x:Static loc:TranslationSource.Instance}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [Admin_Step_AssignSupervisors], Source={x:Static loc:TranslationSource.Instance}}"
                               FontSize="11" TextWrapping="Wrap" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource InfoButtonStyle}" CommandParameter="SupervisorAssignment"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [Admin_Step_Registration], Source={x:Static loc:TranslationSource.Instance}}"
                               FontSize="11" TextWrapping="Wrap" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource InfoButtonStyle}" CommandParameter="Phase1"
                            ToolTip="{Binding [Admin_Phase1Info_Tooltip], Source={x:Static loc:TranslationSource.Instance}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [Admin_Step_Selection], Source={x:Static loc:TranslationSource.Instance}}"
                               FontSize="11" TextWrapping="Wrap" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource InfoButtonStyle}" CommandParameter="Phase2"
                            ToolTip="{Binding [Admin_Phase2Info_Tooltip], Source={x:Static loc:TranslationSource.Instance}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [Admin_Step_Complete], Source={x:Static loc:TranslationSource.Instance}}"
                               FontSize="11" TextWrapping="Wrap" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource InfoButtonStyle}" CommandParameter="Phase3"
                            ToolTip="{Binding [Admin_Phase3Info_Tooltip], Source={x:Static loc:TranslationSource.Instance}}"/>
                </StackPanel>
            </UniformGrid>

        </StackPanel>
    </Border>
</UserControl>
