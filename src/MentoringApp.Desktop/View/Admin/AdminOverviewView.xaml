<UserControl
    x:Class="MentoringApp.View.Admin.AdminOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:MentoringApp.ViewModel.Localization;assembly=MentoringApp.ViewModel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MentoringApp.View.Admin"
    xmlns:overview="clr-namespace:MentoringApp.View.Admin.Overview"
    mc:Ignorable="d"
    FlowDirection="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=FlowDirection}">

    <UserControl.Resources>
        <!-- Base Card Style (used by inline import-instruction and supervisor-assignment cards) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,24,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Phase Stepper -->
            <RowDefinition Height="*"/>    <!-- Main content area (fills all remaining space) -->
            <RowDefinition Height="Auto"/> <!-- Action button (initial steps only) -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>

        <!-- Phase Stepper (spans both columns) -->
        <overview:PhaseStepperView Grid.Row="0" Grid.ColumnSpan="2"/>

        <!-- ── Content Area (Row 1, fills all remaining vertical space) ── -->

        <!-- Initial steps: full-width content (School Config / Import / Supervisor Assignment) -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
              Visibility="{Binding Progress.IsSupervisorsAssigned, Converter={StaticResource InverseBoolToVis}}">
            <!-- Step 1: School configuration -->
            <local:SchoolConfigView DataContext="{Binding SchoolConfig}"
                                    Visibility="{Binding DataContext.Progress.IsSchoolConfigStepActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

            <!-- Step 2: Import users instruction -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding Progress.IsImportStepActive, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                    <TextBlock Text="&#x1F393;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding [Admin_ImportUsers_Instruction_Title], Source={x:Static loc:TranslationSource.Instance}}"
                               FontSize="20" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding [Admin_ImportUsers_Instruction_Body], Source={x:Static loc:TranslationSource.Instance}}"
                               FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/>
                </StackPanel>
            </Border>

            <!-- Step 3: Supervisor Assignment (no extra card wrapper — view has its own CardStyleLg) -->
            <local:SupervisorAssignmentView DataContext="{Binding SupervisorAssignment}"
                                            Visibility="{Binding DataContext.Progress.IsSupervisorAssignmentStepActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Registration phase+: two-column layout -->
        <overview:SupervisorsListView Grid.Row="1" Grid.Column="0" Margin="0,12,30,0"
                                      Visibility="{Binding Progress.IsSupervisorsAssigned, Converter={StaticResource BoolToVis}}"
                                      Loaded="SupervisorsListView_Loaded"/>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
              Visibility="{Binding Progress.IsSupervisorsAssigned, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <overview:PhaseActionsView Grid.Row="0"/>
            <overview:NoticeBoardView Grid.Row="1" Visibility="{Binding Progress.IsSupervisorsAssigned, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Action buttons at bottom (initial steps only, full width, plain text) -->
        <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="0,14"
                FontSize="15" FontWeight="SemiBold" Foreground="White" BorderThickness="0" Background="#A855F7"
                Visibility="{Binding Progress.IsSchoolConfigStepActive, Converter={StaticResource BoolToVis}}"
                IsEnabled="{Binding CanCompleteSchoolConfig}"
                Command="{Binding CompleteSchoolConfigCommand}"
                Content="{Binding [Admin_CompleteSchoolConfig_Button], Source={x:Static loc:TranslationSource.Instance}}">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
        </Button>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="0,14"
                FontSize="15" FontWeight="SemiBold" Foreground="White" BorderThickness="0" Background="#10B981"
                Visibility="{Binding Progress.IsImportStepActive, Converter={StaticResource BoolToVis}}"
                Command="{Binding MarkUsersImportedCommand}"
                Content="{Binding [Admin_BeginRegistration_Button], Source={x:Static loc:TranslationSource.Instance}}">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
        </Button>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="0,14"
                FontSize="15" FontWeight="SemiBold" Foreground="White" BorderThickness="0" Background="#A855F7"
                Visibility="{Binding Progress.IsSupervisorAssignmentStepActive, Converter={StaticResource BoolToVis}}"
                IsEnabled="{Binding SupervisorAssignment.AllClassesAssigned}"
                Command="{Binding CompleteSupervisorAssignmentCommand}"
                Content="{Binding [Admin_CompleteSupervisorAssignment_Button], Source={x:Static loc:TranslationSource.Instance}}">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
        </Button>
    </Grid>
</UserControl>
