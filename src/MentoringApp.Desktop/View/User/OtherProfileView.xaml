<UserControl x:Class="MentoringApp.View.User.OtherProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:MentoringApp.View.Components"
             xmlns:loc="clr-namespace:MentoringApp.ViewModel.Localization;assembly=MentoringApp.ViewModel"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="400"
             FlowDirection="{Binding Source={x:Static loc:TranslationSource.Instance}, Path=FlowDirection}">

    <ScrollViewer Background="#F4F7FE" VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource PageMargin}">
            <Border
                Background="White"
                CornerRadius="16"
                Padding="28"
                MaxWidth="420"
                HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <StackPanel>

                    <components:ProfilePictureControl
                        Width="96" Height="96"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        ImagePath="{Binding User.ProfilePicturePath}"
                        Gender="{Binding User.Gender}" />

                    <TextBlock
                        Text="{Binding User.UserName}"
                        FontSize="24" FontWeight="Bold"
                        Foreground="#111827"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,4"/>

                    <!-- For non-students: plain role label -->
                    <TextBlock
                        Text="{Binding RoleName}"
                        FontSize="14" Foreground="#6B7280"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsStudent, Converter={StaticResource InverseBoolToVis}}"/>

                    <!-- For students: mentor/mentee badges -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16"
                                Visibility="{Binding IsStudent, Converter={StaticResource BoolToVis}}">
                        <Border Background="#DCFCE7" CornerRadius="10" Padding="10,4" Margin="4,0"
                                Visibility="{Binding HasMentorProfile, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding [Admin_ManageUsers_Mentor], Source={x:Static loc:TranslationSource.Instance}}" Foreground="#16A34A" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#DBEAFE" CornerRadius="10" Padding="10,4" Margin="4,0"
                                Visibility="{Binding HasMenteeProfile, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding [Admin_ManageUsers_Mentee], Source={x:Static loc:TranslationSource.Instance}}" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#FEF3C7" CornerRadius="10" Padding="10,4" Margin="4,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasMentorProfile}" Value="False"/>
                                                <Condition Binding="{Binding HasMenteeProfile}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding [Admin_ManageUsers_NoRole], Source={x:Static loc:TranslationSource.Instance}}" Foreground="#D97706" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#F3F4F6"/>

                    <!-- Email -->
                    <TextBlock
                        Text="{Binding [OtherProfile_Email_Label], Source={x:Static loc:TranslationSource.Instance}}"
                        FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                        Margin="0,16,0,4"/>
                    <TextBlock
                        Text="{Binding User.Email}"
                        FontSize="15" Foreground="#374151" FontWeight="Medium"/>

                    <!-- Phone — supervisors only -->
                    <StackPanel Visibility="{Binding IsSupervisor, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Text="{Binding [OtherProfile_PhoneNumber_Label], Source={x:Static loc:TranslationSource.Instance}}"
                            FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                            Margin="0,16,0,4"/>
                        <TextBlock
                            Text="{Binding User.PhoneNumber}"
                            FontSize="15" Foreground="#374151" FontWeight="Medium"/>
                    </StackPanel>

                    <!-- Gender -->
                    <TextBlock
                        Text="{Binding [OtherProfile_Gender_Label], Source={x:Static loc:TranslationSource.Instance}}"
                        FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                        Margin="0,16,0,4"/>
                    <TextBlock
                        Text="{Binding GenderDisplay}"
                        FontSize="15" Foreground="#374151" FontWeight="Medium"/>

                    <!-- Student-only section -->
                    <StackPanel Visibility="{Binding IsStudent, Converter={StaticResource BoolToVis}}">

                        <TextBlock
                            Text="{Binding [OtherProfile_Grade_Label], Source={x:Static loc:TranslationSource.Instance}}"
                            FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                            Margin="0,16,0,4"/>
                        <TextBlock FontSize="15" Foreground="#374151" FontWeight="Medium">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource GradeClassDisplay}">
                                    <Binding Path="GradeName"/>
                                    <Binding Path="ClassNum"/>
                                    <Binding Source="{x:Static loc:TranslationSource.Instance}" Path="CurrentCulture"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- Mentor fields: subject to teach + preferred mentee gender -->
                        <StackPanel Visibility="{Binding HasMentorProfile, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Text="{Binding [Register_SubjectToTeach_Tag], Source={x:Static loc:TranslationSource.Instance}}"
                                FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                                Margin="0,16,0,4"/>
                            <TextBlock
                                Text="{Binding TeachingSubject}"
                                FontSize="15" Foreground="#374151" FontWeight="Medium"/>

                            <TextBlock
                                Text="{Binding [OtherProfile_PreferredMenteeGender_Label], Source={x:Static loc:TranslationSource.Instance}}"
                                FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                                Margin="0,16,0,4"/>
                            <TextBlock
                                Text="{Binding PreferredMenteeGenderDisplay}"
                                FontSize="15" Foreground="#374151" FontWeight="Medium"/>
                        </StackPanel>

                        <!-- Mentee fields: subject to learn + preferred mentor gender -->
                        <StackPanel Visibility="{Binding HasMenteeProfile, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Text="{Binding [Register_SubjectToLearn_Tag], Source={x:Static loc:TranslationSource.Instance}}"
                                FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                                Margin="0,16,0,4"/>
                            <TextBlock
                                Text="{Binding LearningSubject}"
                                FontSize="15" Foreground="#374151" FontWeight="Medium"/>

                            <TextBlock
                                Text="{Binding [OtherProfile_PreferredMentorGender_Label], Source={x:Static loc:TranslationSource.Instance}}"
                                FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                                Margin="0,16,0,4"/>
                            <TextBlock
                                Text="{Binding PreferredMentorGenderDisplay}"
                                FontSize="15" Foreground="#374151" FontWeight="Medium"/>
                        </StackPanel>

                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
