// This file is the source of truth when the env variable "ASPNETCORE_ENVIRONMENT" is set to "Development".
// It is loaded AFTER appsettings.json and only the keys below override the base file (deep merge);
// every other base key (Issuer, Audience, ExpiryHours, AllowedHosts, ...) still applies.
// Env variables can be found in VS (project -> Properties -> search 'env' -> open debug launch profiles UI).
{
  "AppSettings": {
    "RecreateDbOnStartup": true,        // Dev: rebuild the DB on each run.
    "SkipVerificationCode": true,       // Dev: skip the emailed login code so logging in is fast.
    "AdminEmail": "eitanamir09@gmail.com"  // Dev admin login email (overrides the base school@gmail.com).
  },
  // SQLite database file the API opens. Only defined here (the base file falls back to a default path).
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../MentoringApp.Data/Resources/Database/mentoring.db"
  },
  "JwtSettings": {
    "Secret": "dev-secret-key-at-least-32-characters-long"  // Dev-only signing key. Only Secret is overridden; Issuer/Audience/ExpiryHours come from the base file.
  },
  "AllowedOrigins": "http://localhost:5041,https://localhost:5041",
  // Real SMTP sender used in dev so verification/notification emails actually send.
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "FromEmail": "servicehandler055@gmail.com",
    "FromPassword": "acoo uzez oweu elug"  // Gmail app password — secret; do not commit to a public repo (see note).
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
