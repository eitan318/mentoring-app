// BASE configuration for the API. Loaded in every environment.
// When ASPNETCORE_ENVIRONMENT = "Development", appsettings.Development.json is loaded
// AFTER this file and deep-merges on top, overriding any keys it redefines (the rest stay).
// Env variable location: VS -> project Properties -> search 'env' -> open debug launch profiles UI.
{
  // Bound to MentoringApp.Service.AppSettings (IOptions<AppSettings>) in Program.cs / ServiceDependencyInjection.
  "AppSettings": {
    "RecreateDbOnStartup": true,        // Dev flag: drop & recreate the DB schema on startup. Should be false in production.
    "SkipVerificationCode": true,       // Dev flag: bypass the emailed login code. Should be false in production.
    "AdminEmail": "school@gmail.com"    // Email of the seeded initial admin so the school can first log in. Set by developers.
  },
  // Bound to MentoringApp.Api.Helpers.JwtSettings; used by JwtHelper to sign tokens and by Program.cs to validate them.
  "JwtSettings": {
    "Secret": "CHANGE_ME_TO_A_32_CHAR_MIN_SECRET",  // Symmetric signing key for JWTs. MUST be >= 32 chars; override per environment.
    "Issuer": "MentoringApp",           // 'iss' claim stamped on issued tokens and validated on incoming ones.
    "Audience": "MentoringApp",         // 'aud' claim stamped on issued tokens and validated on incoming ones.
    "ExpiryHours": 8                    // How long an issued token stays valid.
  },
  // Comma-separated origins allowed by CORS (the desktop/web clients). Read in Program.cs.
  "AllowedOrigins": "http://localhost:5173,http://localhost:5041",
  // Bound to EmailService (SMTP credentials). FromEmail/FromPassword are blank here; the dev file fills them in.
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "FromEmail": "",
    "FromPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
